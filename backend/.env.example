# Variables de entorno del backend
# Copiar este archivo como .env y completar los valores

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de datos MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centro_hogar

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_por_uno_seguro_minimo_32_chars
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Admin inicial (se crea automáticamente si no existe ningún admin en la DB) ──
ADMIN_EMAIL=admin@centrohogar.com
ADMIN_PASSWORD=cambia_esta_password_segura
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Sistema
