# Variables de entorno del backend
# Copiar este archivo como .env y completar los valores

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Base de datos MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=centro_hogar

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_por_uno_seguro_minimo_32_chars
JWT_EXPIRES_IN=8h

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL del frontend (React)
FRONTEND_URL=http://localhost:5173

# ─── Admin inicial (se usa solo si no existe ningún admin en la DB) ───────────
ADMIN_EMAIL=admin@centrohogar.com
ADMIN_PASSWORD=cambia_esta_password_segura
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Sistema

# ─── Google Sheets (sincronización manual desde Ajustes) ───────────────────────
# Email de la cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio (pegar con \n escapados)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
